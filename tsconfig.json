{
  "compilerOptions": {
    "target": "ES2020",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "types": [
      "node"
    ]
  },
  "include": ["src"],
  "exclude": [
    "node_modules"
  ]
}
